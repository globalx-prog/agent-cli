# Tailscale Remote CLI & Inferenz Konfiguration
# Ermöglicht sichere Fernsteuerung der Agent-CLI von mobilen Geräten oder Laptops
# OHNE Öffnung von WAN-Ports und OHNE Cloudflare-Payload-Limits.

# Host Tailscale IP des KI-Rechners:
TAILSCALE_HOST_IP="100.x.y.z"
TAILSCALE_MAGIC_DNS="clemi-pc.tailnet"

# Ollama Inferenz-Endpunkt über Tailscale:
OLLAMA_REMOTE_URL="http://100.x.y.z:11434"
LLAMA_SPEEDUP_LOCAL_URL="http://127.0.0.1:5002/v1"

# SSH Remote Session für OpenCode / Goose CLI:
# Ausführung vom Remote-Client (Laptop/Macbook/iPad):
# ssh clemi@100.x.y.z -t "cd /home/clemi/Projekte/LLM/agent-cli-setup && ./scripts/start_agent_session.sh"
